{
  "name": "folio-desktop",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test --test-concurrency=1 \"tests/**/*.test.ts\"",
    "preview": "vite preview",
    "tauri": "tauri",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test:unit": "node --experimental-strip-types --test --test-concurrency=1 \"tests/unit/*.test.ts\"",
    "test:contract": "node --experimental-strip-types --test --test-concurrency=1 \"tests/contract/*.test.ts\"",
    "test:coverage": "node --experimental-strip-types --experimental-test-coverage --test --test-concurrency=1 \"tests/**/*.test.ts\"",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.3.0",
    "@tauri-apps/api": "^2.1.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-opener": "^2.2.0",
    "@zenuml/core": "^4.13.2",
    "codemirror": "^6.0.1",
    "highlight.js": "^11.12.0",
    "mermaid": "^11.17.2",
    "solid-js": "^1.9.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "jsdom": "^31.0.1",
    "typescript": "~5.8.2",
    "vite": "^6.0.0",
    "vite-plugin-solid": "^2.11.0"
  },
  "engines": {
    "node": ">=20"
  }
}
